class patient
{
    string FullName, Birthday, Sex, DrugName, Dose, frequency, Reasonforvisit, Reportedsymptoms, Doctorobservations,
    Previousillnesses, Allergies, Immunizations;
    long PhoneNumber , ID;

    public patient(string FullName, string Birthday, string Sex, string DrugName, string Dose, string frequency, 
    string Reasonforvisit, string Reportedsymptoms, string Doctorobservations,
    string Previousillnesses, string Allergies, string Immunizations, long PhoneNumber, long ID)
    {
        this.ID = ID;
        this.FullName = FullName;
        this.Birthday = Birthday;
        this.Sex = Sex;
        this.DrugName = DrugName;
        this.Dose = Dose;
        this.frequency = frequency;
        this.Reasonforvisit = Reasonforvisit;
        this.Reportedsymptoms = Reportedsymptoms;
        this.Doctorobservations = Doctorobservations;
        this.Previousillnesses = Previousillnesses;
        this.Allergies = Allergies;
        this.Immunizations = Immunizations;
        this.PhoneNumber = PhoneNumber;
        
    }

    public void patientinfo()
    {
        Console.WriteLine("==========Patient==========");
        Console.WriteLine($"FullName: {FullName}\n" +
        $"Birthday: {Birthday}\n" +
        $"Sex: {Sex}\n" +
        $"PhoneNumber: {PhoneNumber}\n" +
        $"ID: {ID}\n" + 
        $"==========Medication==========\n" + 
        $"DrugName: {DrugName}\n" +
        $"Dose: {Dose}\n" +
        $"frequency: {frequency}\n" +
        $"==========Diagnostic==========\n" +
        $"Reasonforvisit: {Reasonforvisit}\n" +
        $"Reportedsymptoms: {Reportedsymptoms}\n" +
        $"Doctorobservations: {Doctorobservations}\n" +
        $"==========MedicalRecord==========\n" +
        $"Previousillnesses: {Previousillnesses}\n" +
        $"Allergies: {Allergies}\n" +
        $"Immunizations: {Immunizations}\n");
        Console.WriteLine("============================");
    }

