public class Menu
{
    private readonly MaterialService  _matSvc  = new();
    private readonly UsuarioService   _uSvc    = new();
    private readonly PrestamoService  _pSvc    = new();

    public void MostrarPrincipal()
    {
        while (true)
        {
            Console.Clear();
            ConsolaUtil.Titulo("CONTROL DE PRESTAMOS DE MATERIALES");
            Console.WriteLine("  1. Gestionar Materiales");
            Console.WriteLine("  2. Gestionar Usuarios");
            Console.WriteLine("  3. Gestionar Préstamos");
            Console.WriteLine("  4. Reportes");
            Console.WriteLine("  0. Salir");
            ConsolaUtil.Separador();
            Console.Write("  Opcion: ");

            switch (Console.ReadLine()?.Trim())
            {
                case "1": MenuMateriales(); break;
                case "2": MenuUsuarios();   break;
                case "3": MenuPrestamos();  break;
                case "4": MenuReportes();   break;
                case "0":
                    Console.WriteLine("\n  ¡Gracias Por Usar Nuestro Servicio!\n");
                    return;
                default:
                    ConsolaUtil.Error("Opcion no valida.");
                    ConsolaUtil.Pausa();
                    break;
            }
        }
    }
    private void MenuMateriales()
    {
        while (true)
        {
            Console.Clear();
            ConsolaUtil.Titulo("MATERIALES");
            Console.WriteLine("  1. Ver todos los materiales");
            Console.WriteLine("  2. Ver disponibles");
            Console.WriteLine("  3. Buscar material");
            Console.WriteLine("  4. Registrar nuevo material");
            Console.WriteLine("  5. Eliminar material");
            Console.WriteLine("  0. Volver");
            ConsolaUtil.Separador();
            Console.Write("  Opcion: ");

            switch (Console.ReadLine()?.Trim())
            {
                case "1": ListarMateriales(todos: true);  break;
                case "2": ListarMateriales(todos: false); break;
                case "3": BuscarMaterial();               break;
                case "4": RegistrarMaterial();            break;
                case "5": EliminarMaterial();             break;
                case "0": return;
                default:
                    ConsolaUtil.Error("Opcion no valida.");
                    ConsolaUtil.Pausa();
                    break;
            }
        }
    }

    private void ListarMateriales(bool todos)
    {
        Console.Clear();
        ConsolaUtil.Titulo(todos ? "TODOS LOS MATERIALES" : "MATERIALES DISPONIBLES");

        var lista = todos ? _matSvc.ListarTodos() : _matSvc.ListarDisponibles();

        if (lista.Count == 0)
        {
            ConsolaUtil.Info("No hay materiales registrados.");
        }
        else
        {
            foreach (var m in lista)
{
            Console.ForegroundColor = m.Disponible ? ConsoleColor.White : ConsoleColor.DarkGray;
            Console.WriteLine($"  {m}");
            Console.ResetColor();
}
        }
        ConsolaUtil.Pausa();
    }

    private void BuscarMaterial()
    {
        Console.Clear();
        ConsolaUtil.Titulo("BUSCAR MATERIAL");
        string nombre = ConsolaUtil.LeerTexto("Nombre a buscar");
        var lista = _matSvc.Buscar(nombre);

        if (lista.Count == 0)
            ConsolaUtil.Error("No se encontraron materiales.");
        else
            foreach (var m in lista)
                Console.WriteLine($"  {m}");

        ConsolaUtil.Pausa();
    }

    private void RegistrarMaterial()
{
    Console.Clear();
    ConsolaUtil.Titulo("REGISTRAR MATERIAL");

    string nombre = ConsolaUtil.LeerTexto("Nombre");
    string desc   = ConsolaUtil.LeerTexto("Descripcion (opcional)");

    Console.WriteLine("  Selecciona el tipo:");
    Console.WriteLine("  [1] Lapicero");
    Console.WriteLine("  [2] Cuaderno");
    Console.WriteLine("  [3] Marcador");
    Console.WriteLine("  [4] Otro");
    string opTipo = ConsolaUtil.LeerTexto("Opcion");

   Material nuevo = opTipo switch
    {
    "1" => new Lapicero(nombre),
    "2" => new Cuaderno(nombre),
    "3" => new Marcador(nombre),
    "4" => new Otro(nombre),      
    _   => new Otro(nombre)      
    };

    nuevo.Descripcion = desc;

    var (ok, msg) = _matSvc.Registrar(nuevo);
    if (ok) ConsolaUtil.Ok(msg);
    else    ConsolaUtil.Error(msg);
    ConsolaUtil.Pausa();
}

    private void EliminarMaterial()
    {
        Console.Clear();
        ConsolaUtil.Titulo("ELIMINAR MATERIAL");
        int id = ConsolaUtil.LeerEntero("ID del material a eliminar");
        var (ok, msg) = _matSvc.Eliminar(id);
        if (ok) ConsolaUtil.Ok(msg);
        else    ConsolaUtil.Error(msg);
        ConsolaUtil.Pausa();
    }

     private void MenuUsuarios()
    {
        while (true)
        {
            Console.Clear();
            ConsolaUtil.Titulo("USUARIOS");
            Console.WriteLine("  1. Ver todos los usuarios");
            Console.WriteLine("  2. Buscar usuario");
            Console.WriteLine("  3. Registrar nuevo usuario");
            Console.WriteLine("  4. Eliminar usuario");
