using Microsoft.Data.SqlClient;

namespace PrestamosApp.DAL;

public static class ConexionDB
{
    private const string CadenaConexion =
    "Server=DESKTOP-HLROTNA\\SQLEXPRESS;Database=PrestamosDB;Trusted_Connection=True;TrustServerCertificate=True";
    public static SqlConnection ObtenerConexion()
    {
        var conexion = new SqlConnection(CadenaConexion);
        conexion.Open();
        return conexion;
    }

    public static bool ProbarConexion()
    {
        try
        {
            using var con = ObtenerConexion();
            return con.State == System.Data.ConnectionState.Open;
        }
        catch
        {
            return false;
        }
    }
}
