            var name1 = Console.ReadLine();
            

            
            foreach (var id in ids)
            {
                var isBestFriend  = bestFriends[id];
                Console.WriteLine(id);

                if(names[id] == name1)
            {
                 string isBestFriendStr = (isBestFriend == true) ? "Si" : "No";

